# ============================================
# ENTERPRISE WHATSAPP BUSINESS API PLATFORM
# Environment Configuration Template
# ============================================

# ----------------
# CRITICAL - REQUIRED FOR PRODUCTION
# ----------------

# Authentication Secret (REQUIRED)
# Generate with: openssl rand -base64 32
# This MUST be set before running the installer
NEXTAUTH_SECRET=""

# Next.js Auth URL (REQUIRED)
# Set to your production domain or http://localhost:3000 for local
NEXTAUTH_URL="http://localhost:3000"

# Encryption Key (REQUIRED)
# Generate with: openssl rand -hex 32
# Used to encrypt WhatsApp credentials in database
ENCRYPTION_KEY=""

# ----------------
# DATABASE CONNECTION
# ----------------

# PostgreSQL Connection String
DATABASE_URL="postgresql://whatsapp:JoalcnpPuVQtqFnq@72.61.249.147:6543/whatsappbizapi"

# ----------------
# APPLICATION CONFIGURATION
# ----------------

# Public App URL (used for webhooks and redirects)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Node Environment
NODE_ENV="development"

# ----------------
# WHATSAPP BUSINESS API (Optional - Can be configured via installer)
# ----------------

# Meta App Credentials
WHATSAPP_APP_ID=""
WHATSAPP_APP_SECRET=""

# Webhook Configuration
WHATSAPP_VERIFY_TOKEN=""

# Business Account Details
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""

# API Access Token
WHATSAPP_ACCESS_TOKEN=""

# ----------------
# EMAIL CONFIGURATION (Optional)
# ----------------

# SMTP Settings for email notifications
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

# ----------------
# OPTIONAL FEATURES
# ----------------

# Redis for queue management (optional)
REDIS_URL=""

# File upload limits (in MB)
MAX_FILE_SIZE="10"

# Session timeout (in minutes)
SESSION_TIMEOUT="60"

# Enable debug logging
DEBUG="false"

# ============================================
# SETUP INSTRUCTIONS
# ============================================
# 
# 1. Copy this file to .env.local:
#    cp .env.example .env.local
#
# 2. Generate required secrets:
#    NEXTAUTH_SECRET: openssl rand -base64 32
#    ENCRYPTION_KEY: openssl rand -hex 32
#
# 3. Update the values above
#
# 4. Run database migrations:
#    npx prisma migrate dev
#
# 5. Start the installer:
#    npm run dev
#    Visit: http://localhost:3000/installer
#
# ============================================