# ==============================================================================
# WABIZ PRODUCTION ENVIRONMENT TEMPLATE (TENANT-DRIVEN)
# ==============================================================================
# All WhatsApp Meta API credentials (ID, Token, Secret) and Workspace SMTP 
# settings are stored in the DATABASE to support Multi-Tenancy.
# ==============================================================================

# 1. CORE APPLICATION SETTINGS
NODE_ENV="production"
APP_NAME="WaFiz"
APP_URL="https://whatsapp.biakw.com"
NEXTAUTH_URL="https://whatsapp.biakw.com"

# 2. DATABASE (PostgreSQL)
# Primary and Tenant data are stored here.
DATABASE_URL="postgresql://whatsapp:JoalcnpPuVQtqFnq@72.61.249.147:6543/wabiz_db"

# 3. SECURITY & AUTHENTICATION
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="YgLMDS153SC4Jxf3MHIOgYMkK6sSYAtRQq8w8VFkdRY="
# Generate with: openssl rand -hex 32
JWT_SECRET="e7c86de82e0d08a1d1f47f8d34b2c9c897c6db7811572df20edc8f6e577358c9"

# 4. STRIPE PAYMENTS (Platform-Wide)
# Used for billing your tenants for their platform subscription.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_xxxx"
STRIPE_SECRET_KEY="sk_live_xxxx"
STRIPE_WEBHOOK_SECRET="whsec_xxxx"

# 5. PLATFORM DEFAULTS
# This token is used by Meta to verify your platform's webhook endpoint.
# Configure this in your Meta App Dashboard > Webhook settings.
WHATSAPP_VERIFY_TOKEN="your_shared_webhook_verify_token"

# 6. SYSTEM EMAIL (Platform-Wide SMTP)
# Used for system-level alerts and password resets globally.
SMTP_HOST="smtp.postmarkapp.com"
SMTP_PORT="587"
SMTP_USER="platform_smtp_user"
SMTP_PASSWORD="platform_smtp_password"
SMTP_FROM="system@your-domain.com"
