// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  engineType    = "binary"
  binaryTargets = ["native", "windows"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===== AUTHENTICATION & USERS =====

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  password      String
  avatar        String?
  phone         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  workspaces    WorkspaceMember[]
  sessions      Session[]
  tokens        Token[]
  role          GlobalRole @default(USER)

  @@index([email])
}

enum GlobalRole {
  SUPER_ADMIN
  USER
}

model Session {
  id    String   @id @default(cuid())
  token String   @unique
  userId String
  user  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Token {
  id          String   @id @default(cuid())
  token       String   @unique
  type        String   // "reset", "verify", "2fa"
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime @default(now())

  @@index([userId])
}

// ===== WORKSPACE & MULTI-TENANCY =====

model Workspace {
  id                String    @id @default(cuid())
  name              String
  slug              String    @unique
  logo              String?
  favicon           String?
  description       String?
  country           String?
  timezone          String    @default("UTC")
  currency          String    @default("USD")
  maxAgents         Int       @default(2)
  maxContacts       Int       @default(1000)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  isActive          Boolean   @default(true)

  // Relations
  members           WorkspaceMember[]
  subscription      Subscription?
  whatsappNumbers   WhatsAppNumber[]
  contacts          Contact[]
  conversations     Conversation[]
  automations       Automation[]
  campaigns         Campaign[]
  templates         WhatsAppTemplate[]
  analyticsData     AnalyticsData[]
  settings          WorkspaceSettings?
  compliance        Compliance?
  ledger            Ledger?

  @@index([slug])
}

model WorkspaceMember {
  id          String    @id @default(cuid())
  role        UserRole  @default(AGENT)
  joinedAt    DateTime  @default(now())
  
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
}

enum UserRole {
  SUPER_ADMIN
  MANAGER
  AGENT
}

model WorkspaceSettings {
  id                    String    @id @default(cuid())
  webhookUrl            String?
  webhookSecret         String?
  smtpHost              String?
  smtpPort              Int?
  smtpUser              String?
  smtpPassword          String?
  smtpFromEmail         String?
  smtpFromName          String?
  aiEnabled             Boolean   @default(false)
  autoReplyEnabled      Boolean   @default(false)
  autoReplyMessage      String?
  useBusinessHours      Boolean   @default(false)
  businessHoursStart    String?
  businessHoursEnd      String?
  darkMode              Boolean   @default(false)
  
  workspaceId String @unique
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ===== WHATSAPP BUSINESS =====

model WhatsAppNumber {
  id                  String    @id @default(cuid())
  displayName         String
  phoneNumber         String
  phoneNumberId       String    @unique  // Meta's phone number ID
  businessAccountId   String
  accessToken         String
  webhookToken        String?
  isVerified          Boolean   @default(false)
  isActive            Boolean   @default(true)
  apiVersion          String    @default("v18.0")
  appId               String?   // Meta App ID for BYOA
  appSecret           String?   // Meta App Secret for BYOA
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  conversations Conversation[]
  campaigns     Campaign[]
  templates     WhatsAppTemplate[]

  @@index([workspaceId])
  @@index([phoneNumber])
}

// ===== CONTACTS & CRM =====

model Contact {
  id            String    @id @default(cuid())
  displayName   String
  email         String?
  phone         String    @unique
  avatar        String?
  tags          String[]  @default([])
  customFields  Json?     // Custom fields stored as JSON
  notes         String?
  status        ContactStatus @default(ACTIVE)
  lastMessageAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  conversations Conversation[]
  
  @@index([workspaceId])
  @@index([phone])
}

enum ContactStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

// ===== CONVERSATIONS & MESSAGING =====

model Conversation {
  id            String    @id @default(cuid())
  status        ConversationStatus @default(OPEN)
  priority      Int       @default(0)
  tags          String[]  @default([])
  notes         String?
  assignedTo    String?   // Agent ID (nullable for unassigned)
  lastMessageAt DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  contactId     String
  contact       Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)

  numberId      String
  number        WhatsAppNumber @relation(fields: [numberId], references: [id], onDelete: Cascade)

  messages      Message[]

  @@index([workspaceId])
  @@index([contactId])
  @@index([numberId])
  @@index([status])
}

enum ConversationStatus {
  OPEN
  PENDING
  RESOLVED
  CLOSED
}

model Message {
  id              String    @id @default(cuid())
  type            MessageType
  content         String
  mediaUrl        String?
  mediaType       String?   // "image", "video", "audio", "document"
  sender          MessageSender
  deliveryStatus  DeliveryStatus @default(SENT)
  metaMessageId   String?   @unique
  isRead          Boolean   @default(false)
  readAt          DateTime?
  createdAt       DateTime  @default(now())

  conversationId  String
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  TEMPLATE
}

enum MessageSender {
  USER
  CONTACT
  BOT
}

enum DeliveryStatus {
  SENT
  DELIVERED
  READ
  FAILED
}

// ===== AUTOMATION & FLOWS =====

model Automation {
  id          String    @id @default(cuid())
  name        String
  description String?
  isActive    Boolean   @default(true)
  trigger     AutomationTrigger
  actions     AutomationAction[] // JSON flow stored as relation
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

enum AutomationTrigger {
  KEYWORD
  MESSAGE_RECEIVED
  NEW_CONTACT
  CONVERSATION_ASSIGNED
  TIME_BASED
}

model AutomationAction {
  id          String    @id @default(cuid())
  type        String    // "send_message", "send_template", "assign_agent", etc.
  config      Json      // Action configuration
  
  automationId String
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@index([automationId])
}

// ===== CAMPAIGNS & BROADCAST =====

model Campaign {
  id              String    @id @default(cuid())
  name            String
  description     String?
  type            CampaignType
  templateId      String?
  content         String?
  mediaUrl        String?
  mediaType       String?
  status          CampaignStatus @default(DRAFT)
  scheduledAt     DateTime?
  sentAt          DateTime?
  totalMessages   Int       @default(0)
  successCount    Int       @default(0)
  failureCount    Int       @default(0)
  readCount       Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  numberId        String
  number          WhatsAppNumber @relation(fields: [numberId], references: [id], onDelete: Cascade)

  recipients      CampaignRecipient[]

  @@index([workspaceId])
  @@index([numberId])
  @@index([status])
}

enum CampaignType {
  BROADCAST
  TARGETED
  TEMPLATE
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  PAUSED
  CANCELLED
}

model CampaignRecipient {
  id          String    @id @default(cuid())
  phoneNumber String
  status      String    @default("pending") // "sent", "delivered", "read", "failed"
  sentAt      DateTime?
  deliveredAt DateTime?
  readAt      DateTime?
  error       String?
  
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
}

// ===== TEMPLATES =====

model WhatsAppTemplate {
  id              String    @id @default(cuid())
  name            String
  category        TemplateCategory
  language        String    @default("en")
  content         String
  headerType      String?   // "TEXT", "IMAGE", "VIDEO", "DOCUMENT"
  headerContent   String?
  footerContent   String?
  buttonJson      Json?
  variables       String[]  @default([]) // e.g., ["name", "order_id"]
  status          TemplateStatus @default(DRAFT)
  metaTemplateId  String?   @unique
  rejectionReason String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  numberId        String
  number          WhatsAppNumber @relation(fields: [numberId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([numberId])
  @@index([status])
}

enum TemplateCategory {
  UTILITY
  MARKETING
  AUTHENTICATION
}

enum TemplateStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
}

// ===== SUBSCRIPTIONS & BILLING =====

model Subscription {
  id                      String    @id @default(cuid())
  status                  SubscriptionStatus @default(ACTIVE)
  planId                  String
  plan                    Plan      @relation(fields: [planId], references: [id])
  stripeCustomerId        String    @unique
  stripeSubscriptionId    String    @unique
  stripePaymentMethodId   String?
  currentPeriodStart      DateTime
  currentPeriodEnd        DateTime
  cancelAtPeriodEnd       Boolean   @default(false)
  cancelledAt             DateTime?
  trialEndsAt             DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  workspaceId             String    @unique
  workspace               Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  invoices                Invoice[]

  @@index([workspaceId])
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
}

model Plan {
  id              String    @id @default(cuid())
  name            String    @unique
  description     String?
  pricingMonthly  Int       // in cents
  pricingYearly   Int?      // in cents
  stripePriceIdMonthly   String?
  stripePriceIdYearly    String?
  maxNumbers      Int
  maxAgents       Int
  maxContacts     Int
  features        String[]  @default([])
  isActive        Boolean   @default(true)
  isFeatured      Boolean   @default(false)
  displayOrder    Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  subscriptions   Subscription[]

  @@index([isActive])
}

model Invoice {
  id                String    @id @default(cuid())
  invoiceNumber    String    @unique
  stripeInvoiceId   String    @unique
  status            InvoiceStatus @default(DRAFT)
  amount            Int       // in cents
  tax               Int       @default(0)
  total             Int
  currency          String    @default("USD")
  pdfUrl            String?
  dueDate           DateTime?
  issuedAt          DateTime
  paidAt            DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  subscriptionId    String
  subscription      Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([status])
}

enum InvoiceStatus {
  DRAFT
  SENT
  VIEWED
  PAID
  OVERDUE
  CANCELLED
}

// ===== ANALYTICS =====

model AnalyticsData {
  id                String    @id @default(cuid())
  date              DateTime  @db.Date
  messagesSent      Int       @default(0)
  messagesReceived  Int       @default(0)
  conversationsOpen Int       @default(0)
  conversationsClosed Int     @default(0)
  averageResponseTime Float   @default(0)
  templatesUsed     Int       @default(0)
  campaignsSent     Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  workspaceId       String
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, date])
  @@index([workspaceId])
}

// ===== INSTALLER & CONFIGURATION =====

model SystemSettings {
  id                  String    @id @default(cuid())
  isInstalled         Boolean   @default(false)
  installationDate    DateTime?
  platformName        String    @default("WaFiz")
  platformDescription String?
  platformLogo        String?
  defaultCurrency     String    @default("USD")
  defaultTimezone     String    @default("UTC")
  supportEmail        String?
  supportPhone        String?
  customDomain        String?   @default("app.wafiz.com")
  brandColor          String?   @default("#2563EB")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([id])
}

// ===== WEBHOOKS =====

model WebhookLog {
  id          String    @id @default(cuid())
  event       String
  data        Json
  status      Int
  response    String?
  createdAt   DateTime  @default(now())
  retryCount  Int       @default(0)

  @@index([event])
  @@index([createdAt])
}

// ===== COMPLIANCE & KYB =====

model Compliance {
  id                 String             @id @default(cuid())
  workspaceId        String             @unique
  workspace          Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  status             ComplianceStatus   @default(PENDING)
  legalName          String?
  registrationNumber String?
  taxId              String?
  address            String?
  city               String?
  country            String? // ISO 3166-1 alpha-2
  website            String?
  reviewedBy         String? // User ID of admin
  reviewedAt         DateTime?
  rejectionReason    String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  documents          ComplianceDocument[]

  @@index([status])
}

enum ComplianceStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  NEEDS_INFO
}

model ComplianceDocument {
  id            String         @id @default(cuid())
  complianceId  String
  compliance    Compliance     @relation(fields: [complianceId], references: [id], onDelete: Cascade)
  type          String // "business_license", "utility_bill", "tax_document", "id_proof"
  url           String // Secured URL
  encryptionKey String? // If encrypted at rest
  status        DocumentStatus @default(PENDING)
  mimeType      String?
  fileSize      Int?
  uploadedAt    DateTime       @default(now())
  reviewedBy    String?
  reviewedAt    DateTime?

  @@index([complianceId])
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

// ===== GOVERNANCE & AUDIT =====

model SystemAudit {
  id        String   @id @default(cuid())
  action    String // "user.impersonate", "billing.credit_add", "settings.update"
  actorId   String // User ID who performed action
  actorName String? // Snapshot of name
  targetId  String? // ID of affected entity (User, Workspace, etc)
  details   Json? // Diff or metadata
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
}

// ===== BILLING & LEDGERS =====

model Ledger {
  id           String        @id @default(cuid())
  workspaceId  String        @unique
  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  balance      Int           @default(0) // in cents
  currency     String        @default("USD")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  transactions Transaction[]
}

model Transaction {
  id          String            @id @default(cuid())
  ledgerId    String
  ledger      Ledger            @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  amount      Int // positive for credit, negative for debit
  type        TransactionType
  status      TransactionStatus @default(COMPLETED)
  referenceId String? // external ID (e.g. Stripe Charge ID, Conversation ID)
  description String?
  metadata    Json?
  createdAt   DateTime          @default(now())

  @@index([ledgerId])
  @@index([type])
}

enum TransactionType {
  DEPOSIT
  USAGE_MARKETING
  USAGE_UTILITY
  USAGE_SERVICE
  USAGE_AUTH
  PLATFORM_FEE
  REFUND
  ADJUSTMENT
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

// ===== CMS & CONTENT =====

model CmsContent {
  id          String   @id @default(cuid())
  key         String   @unique // e.g., "landing_hero", "pricing_faq"
  type        String // "text", "html", "json", "image"
  content     String // The actual content
  metadata    Json?
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
