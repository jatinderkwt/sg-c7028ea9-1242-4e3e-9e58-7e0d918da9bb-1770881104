generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id              String         @id @default(cuid())
  name            String
  domain          String?        @unique
  status          String         @default("active") // active, suspended, disabled
  
  // Branding & Theme
  logo            String?
  primaryColor    String?        @default("#3B82F6")
  secondaryColor  String?        @default("#10B981")
  theme           String?        @default("light")
  
  // Enterprise Settings
  settings        Json?          @default("{}") // Store SaaS settings, SMTP, etc.
  
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // Relations
  users           User[]
  contacts        Contact[]
  conversations   Conversation[]
  templates       Template[]
  campaigns       Campaign[]
  automations     Automation[]
  subscription    Subscription?
  whatsappAccount WhatsAppAccount?
  deals           Deal[]
  tasks           Task[]
  auditLogs       AuditLog[]
  usageLogs       UsageLog[]
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  password      String
  image         String?
  emailVerified DateTime?
  status        String    @default("active")
  
  // Role Based Access Control
  roleId        String?
  role          Role?     @relation(fields: [roleId], references: [id])

  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  assignedConversations Conversation[]
  sentMessages          Message[]
  createdTasks          Task[]
  assignedTasks         Task[] @relation("AssignedTo")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique // super_admin, admin, manager, agent, viewer
  description String?
  permissions String[] // Array of permission strings
  users       User[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SubscriptionPlan {
  id           String         @id @default(cuid())
  name         String         @unique
  price        Float
  billingCycle String         // monthly, yearly
  features     Json           // Plan limits and features
  isActive     Boolean        @default(true)
  
  subscriptions Subscription[]
  
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model Subscription {
  id                 String           @id @default(cuid())
  status             String           // active, trialing, past_due, canceled
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  trialEnd           DateTime?
  
  planId             String
  plan               SubscriptionPlan @relation(fields: [planId], references: [id])
  
  tenantId           String           @unique
  tenant             Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

model WhatsAppAccount {
  id              String   @id @default(cuid())
  phoneNumberId   String
  wabaId          String
  accessToken     String   // Encrypted
  verifyToken     String   // Encrypted
  phoneNumber     String?
  displayName     String?
  qualityRating   String?
  
  tenantId        String   @unique
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Contact {
  id            String   @id @default(cuid())
  phoneNumber   String
  name          String?
  email         String?
  tags          String[]
  customFields  Json?
  
  // Opt-in Compliance
  optInStatus   String   @default("none") // none, opted_in, opted_out
  optInSource   String?
  optInProof    String?
  lastActive    DateTime?

  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  conversations Conversation[]
  deals         Deal[]
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([tenantId, phoneNumber])
}

model Conversation {
  id            String    @id @default(cuid())
  status        String    @default("open") // open, closed, pending
  channel       String    @default("whatsapp")
  unreadCount   Int       @default(0)
  lastMessageAt DateTime  @default(now())
  
  contactId     String
  contact       Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  
  assignedToId  String?
  assignedTo    User?     @relation(fields: [assignedToId], references: [id])
  
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  messages      Message[]
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Message {
  id             String       @id @default(cuid())
  wamid          String?      @unique // WhatsApp Message ID
  direction      String       // inbound, outbound
  type           String       // text, image, video, document, template, interactive
  status         String       // sent, delivered, read, failed
  content        Json
  
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  
  senderId       String?
  sender         User?        @relation(fields: [senderId], references: [id])
  
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Template {
  id          String   @id @default(cuid())
  metaId      String?
  name        String
  category    String   // MARKETING, UTILITY, AUTHENTICATION
  language    String
  components  Json
  status      String   // APPROVED, REJECTED, PENDING
  
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  campaigns   Campaign[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, name, language])
}

model Campaign {
  id              String   @id @default(cuid())
  name            String
  status          String   // draft, scheduled, processing, completed, failed
  scheduledAt     DateTime?
  
  segmentConfig   Json?    // Targeting rules
  stats           Json?    // { sent, delivered, read, failed }
  
  templateId      String
  template        Template @relation(fields: [templateId], references: [id])
  
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Automation {
  id          String   @id @default(cuid())
  name        String
  trigger     String   // keyword, contact_created, etc.
  config      Json     // Trigger conditions and Actions
  isActive    Boolean  @default(true)
  
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Deal {
  id          String   @id @default(cuid())
  title       String
  value       Float    @default(0)
  currency    String   @default("USD")
  stage       String   // new, qualification, negotiation, won, lost
  notes       String?
  
  contactId   String
  contact     Contact  @relation(fields: [contactId], references: [id])
  
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Task {
  id          String   @id @default(cuid())
  title       String
  description String?
  dueDate     DateTime?
  status      String   // pending, in_progress, completed
  priority    String   @default("medium") // low, medium, high
  
  assignedToId String?
  assignedTo   User?   @relation("AssignedTo", fields: [assignedToId], references: [id])
  
  createdById  String
  createdBy    User    @relation(fields: [createdById], references: [id])
  
  tenantId     String
  tenant       Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AuditLog {
  id          String   @id @default(cuid())
  action      String
  resource    String
  resourceId  String?
  details     Json?
  ipAddress   String?
  
  userId      String?
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
}

model UsageLog {
  id           String   @id @default(cuid())
  resourceType String   // message, storage, contact
  quantity     Int
  
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  createdAt    DateTime @default(now())
  
  @@index([tenantId, resourceType, createdAt])
}