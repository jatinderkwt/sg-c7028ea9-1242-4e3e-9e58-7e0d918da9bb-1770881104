generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id            String   @id @default(uuid())
  name          String
  domain        String?  @unique
  email         String?  // Added for contact email
  settings      Json?    @default("{}")
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  users         User[]
  contacts      Contact[]
  conversations Conversation[]
  roles         Role[]
  automations   Automation[]
  deals         Deal[]
  tasks         Task[]
  campaigns     Campaign[]
  templates     Template[]
  whatsappAccount WhatsAppAccount?
  subscription  Subscription?
  auditLogs     AuditLog[]
}

model User {
  id            String    @id @default(uuid())
  email         String
  name          String?
  password      String
  roleId        String
  tenantId      String
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role          Role      @relation(fields: [roleId], references: [id])
  
  assignedConversations Conversation[]
  sentMessages          Message[]
  assignedDeals         Deal[]
  assignedTasks         Task[]
  auditLogs             AuditLog[]

  @@unique([tenantId, email])
}

model Role {
  id          String   @id @default(uuid())
  name        String
  description String?
  tenantId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users       User[]
  permissions Permission[]

  @@unique([tenantId, name])
}

model Permission {
  id         String   @id @default(uuid())
  roleId     String
  resource   String   // e.g., "contacts", "settings"
  action     String   // e.g., "create", "read", "update", "delete"
  tenantId   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  
  @@unique([roleId, resource, action])
}

model SubscriptionPlan {
  id           String   @id @default(uuid())
  name         String
  description  String?
  price        Float
  billingCycle String   // "monthly", "yearly"
  features     Json
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id        String   @id @default(uuid())
  tenantId  String   @unique
  planId    String
  status    String   // "active", "canceled", "past_due"
  startDate DateTime
  endDate   DateTime?
  autoRenew Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan      SubscriptionPlan @relation(fields: [planId], references: [id])
}

model WhatsAppAccount {
  id            String   @id @default(uuid())
  tenantId      String   @unique
  phoneNumberId String
  wabaId        String
  accessToken   String   // Encrypted
  verifyToken   String   // Encrypted
  phoneNumber   String?
  qualityRating String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Contact {
  id             String   @id @default(uuid())
  tenantId       String
  phoneNumber    String
  name           String?
  email          String?
  tags           String[]
  customFields   Json?
  optInStatus    Boolean  @default(false)
  optInSource    String?
  optInProof     String?  // Reference/ID of message/form
  lastActiveAt   DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations  Conversation[]
  deals          Deal[]
  tasks          Task[]

  @@unique([tenantId, phoneNumber])
}

model Conversation {
  id           String   @id @default(uuid())
  tenantId     String
  contactId    String
  status       String   // "open", "closed", "pending"
  assignedToId String?
  lastMessageAt DateTime @default(now())
  unreadCount  Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact      Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  assignedTo   User?     @relation(fields: [assignedToId], references: [id])
  messages     Message[]
}

model Message {
  id             String   @id @default(uuid())
  tenantId       String
  conversationId String
  direction      String   // "inbound", "outbound"
  type           String   // "text", "image", "template", etc.
  content        Json
  status         String   // "sent", "delivered", "read", "failed"
  wamid          String?  @unique // WhatsApp Message ID
  senderId       String?  // User ID if outbound
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User?        @relation(fields: [senderId], references: [id])
}

model Template {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  category    String
  language    String
  components  Json
  status      String   // "APPROVED", "REJECTED", "PENDING"
  metaId      String?  // Meta Template ID
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaigns   Campaign[] // Added opposite relation

  @@unique([tenantId, name, language])
}

model Campaign {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  templateId  String
  segment     Json     // Filter rules
  scheduleAt  DateTime?
  status      String   // "draft", "scheduled", "sending", "completed"
  stats       Json?    // { sent, delivered, read, failed }
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  template    Template @relation(fields: [templateId], references: [id])
}

model Automation {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  description String?
  trigger     String   // "message_received", "tag_added"
  conditions  Json?
  actions     Json     // Workflow steps
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Deal {
  id                String   @id @default(uuid())
  tenantId          String
  contactId         String
  title             String
  value             Float?
  currency          String   @default("USD")
  stage             String
  assignedUserId    String?
  expectedCloseDate DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact      Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  assignedUser User?    @relation(fields: [assignedUserId], references: [id])
}

model Task {
  id             String   @id @default(uuid())
  tenantId       String
  contactId      String?
  title          String
  description    String?
  type           String   // "call", "email", "meeting"
  priority       String   // "low", "medium", "high"
  status         String   // "pending", "completed"
  dueDate        DateTime?
  assignedUserId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact        Contact? @relation(fields: [contactId], references: [id])
  assignedUser   User?    @relation(fields: [assignedUserId], references: [id])
}

model AuditLog {
  id           String   @id @default(uuid())
  tenantId     String
  userId       String?
  action       String
  resourceType String
  resourceId   String?
  details      Json?
  ipAddress    String?
  createdAt    DateTime @default(now())

  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User?    @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([resourceType])
  @@index([createdAt])
}